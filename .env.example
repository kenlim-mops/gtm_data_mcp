# Local STDIO can use the bundled JSON catalog without a database.
GTM_CATALOG_PATH=./data/catalog.json

# Required for durable remote deployment, imports, and source reconciliation.
DATABASE_URL=

# Fixed bearer secret protecting the remote Streamable HTTP endpoint.
# Replace with Runpod-approved OAuth when available.
GTM_MCP_BEARER_TOKEN=

# Disabled by default. Enable only for a separately reviewed restricted-data deployment.
GTM_INCLUDE_RESTRICTED=false

# Optional: enables the UTM module by calling the independent UTM Builder API.
UTM_BUILDER_URL=
UTM_BUILDER_TOKEN=

# Optional: enables configured Notion source connectors.
NOTION_API_TOKEN=

# Vercel automatically supplies this to cron invocations.
CRON_SECRET=

# Local HTTP port.
PORT=8787
